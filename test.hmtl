<style>

body.uxbilling__prestripe_flow #HeaderDeonto.stripe_flow { display: block !important; }



.stripe_flow .line1 {
	width: 100%;
	display: %vendor_prefixes%flex;
	%vendor_prefixes%justify-content: space-between;
	%vendor_prefixes%align-items: center;
}

.stripe_flow .line2, .stripe_flow .line3, .stripe_flow .line4 {
	width: 100%;
	font-size: 11px;
	display: %vendor_prefixes%flex;
	%vendor_prefixes%justify-content: space-between;
	%vendor_prefixes%align-items: center;
}

.stripe_flow .line1 .descr {
	text-transform: uppercase;
	font-size: 14px;
}

.stripe_flow .line1 .price {
	font-size: 17px;
}

.stripe_flow .line1 .price span {
	font-weight: bold;
}

.stripe_flow .line2 .descr, .stripe_flow .line3 .descr {
	font-size: 11px;
}

.stripe_flow .offer_info {
	font-size: 10px;
	color: #9e9e9e;
	margin: 8px auto 0;
	text-align: justify;
}
</style>
