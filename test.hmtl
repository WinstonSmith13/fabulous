<script>
addEvent(document,"flow_event",function(fkevent) {
	if (typeof(fkevent)!=="object") return;
	var event=fkevent.result;
	
	
	if ((event.type=='load_flow') || (event.type=='display_step') || (event.status=="operator_change")) {
		
		
		<?php if ((nauticonf('ppv')) && (($avail_varsys['seo_kw']['oneshot']) || ($avail_varsys['seo_kw']['creditsPack']))) { ?>
			
			lp_conf.dico = {
				"attr_currency": {"EUR": "€", },
				"attr_billingmode": {"Subscription": "abo", },
				"attr_trialperiod": { "Daily": "jour", "Weekly": "semaine", "Monthly":"mois", "Yearly":"an", },
				"attr_recurringperiod": { "Daily": "jour", "Weekly": "semaine", "Monthly":"mois", "Yearly":"an", },
			};
			
			
			var mentions = offerTxt({
				dico: lp_conf.dico,
				default: "{attr_price} {attr_currency}",	//default
			});
			querySelectorAll_do(".mentiondeonto, #HeaderDeonto",{innerHTML: mentions});
			
		<?php } elseif (in_array(nauticonf('directory'),["ppv"])) { ?>
			
			lp_conf.dico = {
				"attr_currency": {"EUR": "€", },
				"attr_billingmode": {"Subscription": "abo", },
				"attr_trialperiod": { "Daily": "jour", "Weekly": "semaine", "Monthly":"mois", "Yearly":"an", },
				"attr_recurringperiod": { "Daily": "jour", "Weekly": "semaine", "Monthly":"mois", "Yearly":"an", },
			};

			
			var mentions = offerTxt({
				dico: lp_conf.dico,
				default: "{attr_billingmode} : {attr_price} {attr_currency} par {attr_recurringperiod} sans engagement",	//default
				if_oneshot: "{attr_price} {attr_currency}",
				if_nocarrier: { default: 'abo : 3 € par semaine' },
			
			//	if_trial: "{attr_trial_price} {attr_currency} pendant {attr_trial_iteration} {attr_trialperiod} puis {attr_billingmode} : {attr_price} {attr_currency} par {attr_recurringperiod} sans engagement",

			if_trial: function(dataobj) {
										
					if ((dataobj.offer.attr_trial_price == 0) && (/daily/i.test(dataobj.offer.attr_trialperiod))) return "1er jour offert puis abo : {attr_price} {attr_currency} par {attr_recurringperiod} sans engagement";
					if ((dataobj.offer.attr_trial_price == 0) && (/weekly/i.test(dataobj.offer.attr_trialperiod))) return "1ère semaine offerte puis abo : {attr_price} {attr_currency} par {attr_recurringperiod} sans engagement";
					if ((dataobj.offer.attr_trial_price == 0) && (/monthly/i.test(dataobj.offer.attr_trialperiod))) return "1er mois offert puis abo : {attr_price} {attr_currency} par {attr_recurringperiod} sans engagement";
					
					//fallback in case
					return "{attr_trial_price} {attr_currency} pendant {attr_trial_iteration} {attr_trialperiod} puis abo : {attr_price} {attr_currency} par {attr_recurringperiod} sans engagement";
				},
			});
			querySelectorAll_do(".mentiondeonto, #HeaderDeonto",{innerHTML: mentions});
			
			
			//NB DE CREDITS JM/MATTHIAS:
			offerTxt({default:function(dataobj) {
				if (/weekly/i.test(dataobj.offer.attr_recurringperiod)) {
					var nbcredits="3";
					if (dataobj.offer.attr_trial_iteration) nbcredits="5"; //ASO
					else nbcredits="8"; //SSO
					querySelectorAll_do('.mention_cgv_credit_number',{innerHTML:nbcredits});
				}
			}});
		
		<?php } elseif (in_array(nauticonf('directory'), ["busuprfr"]) && isset($avail_varsys['user_geoloc']['MMDB_GEOIP2']['MM_ASN']) && $avail_varsys['user_geoloc']['MMDB_GEOIP2']['MM_ASN'] == 15557) { ?>
			
			console.log('inthere');
			lp_conf.dico = {
				"attr_currency": {"EUR": "euros", },
				"attr_billingmode": {"Subscription": "abo", },
				"attr_trialperiod": { "Daily": "jour", "Weekly": "semaine", "Monthly":"mois", "Yearly":"an", },
				"attr_recurringperiod": { "Daily": "jour", "Weekly": "semaine", "Monthly":"mois", "Yearly":"an", },
			};
			
			var mentions = offerTxt({
				dico: lp_conf.dico,
				default: "9.99€/mois",	//default
			});
			querySelectorAll_do(".mentiondeonto, #HeaderDeonto",{innerHTML: mentions});

			
		<?php } elseif (in_array(nauticonf('directory'),["pjat"])) { ?>
			
			lp_conf.dico = {
				"attr_currency": {"EUR": "euros", },
				"attr_billingmode": {"Subscription": "abo", },
				"attr_trialperiod": { "Daily": "jour", "Weekly": "semaine", "Monthly":"mois", "Yearly":"an", },
				"attr_recurringperiod": { "Daily": "jour", "Weekly": "semaine", "Monthly":"mois", "Yearly":"an", },
			};
			
			var mentions = offerTxt({
				dico: lp_conf.dico,
				default: "{attr_billingmode} : {attr_price} {attr_currency} / {attr_recurringperiod}",	//default
				if_oneshot: "{attr_price} {attr_currency}",
				if_nocarrier: { default: 'abo : 3 euros / semaine' },
			
			//	if_trial: "{attr_trial_price} {attr_currency} pendant {attr_trial_iteration} {attr_trialperiod} puis {attr_billingmode} : {attr_price} {attr_currency} / {attr_recurringperiod}",
				if_trial: function(dataobj) {
										
					if ((dataobj.offer.attr_trial_price == 0) && (/daily/i.test(dataobj.offer.attr_trialperiod))) return "1er jour offert puis abo : {attr_price} {attr_currency} / {attr_recurringperiod}";
					if ((dataobj.offer.attr_trial_price == 0) && (/weekly/i.test(dataobj.offer.attr_trialperiod))) return "1ère semaine offerte puis abo : {attr_price} {attr_currency} / {attr_recurringperiod}";
					if ((dataobj.offer.attr_trial_price == 0) && (/monthly/i.test(dataobj.offer.attr_trialperiod))) return "1er mois offert puis abo : {attr_price} {attr_currency} / {attr_recurringperiod}";
					
					//fallback in case
					return "{attr_trial_price} {attr_currency} pendant {attr_trial_iteration} {attr_trialperiod} puis abo : {attr_price} {attr_currency} / {attr_recurringperiod}";
				},
			});
			querySelectorAll_do(".mentiondeonto, #HeaderDeonto",{innerHTML: mentions});
			
		<?php } else { ?> /* ALL OTHERS */
		
			lp_conf.dico = {
				"attr_currency": {"EUR": "€", },
				"attr_billingmode": {"Subscription": "abo", },
				"attr_trialperiod": { "Daily": "jour", "Weekly": "semaine", "Monthly":"mois", "Yearly":"an", },
				"attr_recurringperiod": { "Daily": "jour", "Weekly": "semaine", "Monthly":"mois", "Yearly":"an", },
			};
			
			
			var mentions = offerTxt({
				dico: lp_conf.dico,
				default: "{attr_billingmode} : {attr_price} {attr_currency} / {attr_recurringperiod}",	//default
				if_oneshot: "{attr_price} {attr_currency}",
				if_nocarrier: { default: 'abo : 3 € / semaine' },
				// if_nocarrier: function(dataobj) { 
				// 	if (lp_conf.asn === 'AS15557') return "1ère semaine offerte puis abo : {attr_price} {attr_currency}/{attr_recurringperiod}";
				//  	return 'abo : 3 € / semaine'; 
				//  },
			
			//	if_trial: "{attr_trial_price} {attr_currency} pendant {attr_trial_iteration} {attr_trialperiod} puis {attr_billingmode} : {attr_price} {attr_currency} / {attr_recurringperiod}",
				if_trial: function(dataobj) {
										
					if ((dataobj.offer.attr_trial_price == 0) && (/daily/i.test(dataobj.offer.attr_trialperiod))) return "1er jour offert puis abo : {attr_price} {attr_currency}/{attr_recurringperiod}";
					if ((dataobj.offer.attr_trial_price == 0) && (/weekly/i.test(dataobj.offer.attr_trialperiod))) return "1ère semaine offerte puis abo : {attr_price} {attr_currency}/{attr_recurringperiod}";
					if ((dataobj.offer.attr_trial_price == 0) && (/monthly/i.test(dataobj.offer.attr_trialperiod))) return "1er mois offert puis abo : {attr_price} {attr_currency}/{attr_recurringperiod}";
					
					//fallback in case
					return "{attr_trial_price} {attr_currency} pendant {attr_trial_iteration} {attr_trialperiod} puis abo : {attr_price} {attr_currency}/{attr_recurringperiod}";
				},
			});
			querySelectorAll_do(".mentiondeonto, #HeaderDeonto",{innerHTML: mentions});

			<?php if (in_array(nauticonf('directory'),["pmmf"])) { ?>
				//NB DE CREDITS JM/MATTHIAS:
				offerTxt({default:function(dataobj) {
					if (/weekly/i.test(dataobj.offer.attr_recurringperiod)) {
						var nbcredits="3";
						if (dataobj.offer.attr_trial_iteration) nbcredits="5"; //ASO
						else nbcredits="8"; //SSO
						querySelectorAll_do('.mention_cgv_credit_number',{innerHTML:nbcredits});
					}
				}});
			<?php } ?>
			
		<?php } ?>
		
			
			
		
		/*
		var mentions = offerTxt({
			dico: lp_conf.dico,
		
			//if carrier is known
			//default: "{product_commercial_name} Unbegrenzter Zugang zu 2000 Spielen und Videos mit Anleitungen &amp; Tipps für nur {attr_price} {attr_currency} pro {attr_recurringperiod} (inkl MwSt.)​",	//default
